{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "mkado.dev design tokens, 'two-ink print' (docs/brand-guidelines.md v2.0). Mirrors src/styles/global.css.",
  "primitive": {
    "color": {
      "paper": {
        "50": { "$value": "#F4F3ED", "$type": "color" },
        "100": { "$value": "#EBE9E1", "$type": "color" },
        "200": { "$value": "#D9D7CE", "$type": "color" },
        "300": { "$value": "#C4C2B8", "$type": "color" }
      },
      "ink": {
        "100": { "$value": "#ECEBE4", "$type": "color" },
        "300": { "$value": "#B6B5AD", "$type": "color" },
        "400": { "$value": "#8D8D87", "$type": "color" },
        "500": { "$value": "#5F626B", "$type": "color" },
        "600": { "$value": "#4A4C54", "$type": "color" },
        "700": { "$value": "#3A3B43", "$type": "color" },
        "800": { "$value": "#2A2B32", "$type": "color" },
        "850": { "$value": "#1A1B21", "$type": "color" },
        "900": { "$value": "#121317", "$type": "color" },
        "950": { "$value": "#17181C", "$type": "color" }
      },
      "signal": {
        "100": { "$value": "#D6DEF9", "$type": "color" },
        "300": { "$value": "#A9BAFF", "$type": "color" },
        "400": { "$value": "#8EA3FF", "$type": "color" },
        "500": { "$value": "#6F8BFF", "$type": "color" },
        "700": { "$value": "#2447D6", "$type": "color" },
        "800": { "$value": "#1A36AD", "$type": "color" },
        "900": { "$value": "#1D2A66", "$type": "color" }
      },
      "live": {
        "100": { "$value": "#D9EFE0", "$type": "color" },
        "400": { "$value": "#3FC46F", "$type": "color" },
        "700": { "$value": "#157A3B", "$type": "color" },
        "900": { "$value": "#0F2C1B", "$type": "color" }
      },
      "down": {
        "400": { "$value": "#F59E0B", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "Instrument Serif, Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "body": { "$value": "'Instrument Sans Variable', 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, 'Cascadia Mono', 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension" },
      "lg": { "$value": "14px", "$type": "dimension" }
    },
    "motion": {
      "ease": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
      "fast": { "$value": "200ms", "$type": "duration" },
      "base": { "$value": "350ms", "$type": "duration" },
      "slow": { "$value": "700ms", "$type": "duration" }
    }
  },
  "semantic": {
    "light": {
      "paper": { "$value": "{primitive.color.paper.50}", "$type": "color" },
      "paper-2": { "$value": "{primitive.color.paper.100}", "$type": "color" },
      "ink": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "ink-2": { "$value": "{primitive.color.ink.600}", "$type": "color" },
      "ink-3": { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "line": { "$value": "{primitive.color.paper.200}", "$type": "color" },
      "line-2": { "$value": "{primitive.color.paper.300}", "$type": "color" },
      "accent": { "$value": "{primitive.color.signal.700}", "$type": "color" },
      "accent-deep": { "$value": "{primitive.color.signal.800}", "$type": "color" },
      "accent-tint": { "$value": "{primitive.color.signal.100}", "$type": "color" },
      "accent-on-ink": { "$value": "{primitive.color.signal.500}", "$type": "color" },
      "on-accent": { "$value": "{primitive.color.paper.50}", "$type": "color" },
      "live": { "$value": "{primitive.color.live.700}", "$type": "color" },
      "live-tint": { "$value": "{primitive.color.live.100}", "$type": "color" },
      "down": { "$value": "{primitive.color.down.700}", "$type": "color" },
      "print-paper": { "$value": "{primitive.color.paper.50}", "$type": "color" }
    },
    "dark": {
      "paper": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "paper-2": { "$value": "{primitive.color.ink.850}", "$type": "color" },
      "ink": { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "ink-2": { "$value": "{primitive.color.ink.300}", "$type": "color" },
      "ink-3": { "$value": "{primitive.color.ink.400}", "$type": "color" },
      "line": { "$value": "{primitive.color.ink.800}", "$type": "color" },
      "line-2": { "$value": "{primitive.color.ink.700}", "$type": "color" },
      "accent": { "$value": "{primitive.color.signal.400}", "$type": "color" },
      "accent-deep": { "$value": "{primitive.color.signal.300}", "$type": "color" },
      "accent-tint": { "$value": "{primitive.color.signal.900}", "$type": "color" },
      "accent-on-ink": { "$value": "{primitive.color.signal.700}", "$type": "color" },
      "on-accent": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "live": { "$value": "{primitive.color.live.400}", "$type": "color" },
      "live-tint": { "$value": "{primitive.color.live.900}", "$type": "color" },
      "down": { "$value": "{primitive.color.down.400}", "$type": "color" },
      "print-paper": { "$value": "{primitive.color.paper.50}", "$type": "color" }
    }
  }
}
