---
import '../styles/global-alt.css';
import { profile } from '../data/site';

const title = `${profile.name} — ${profile.title} (alt style)`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />

    <script is:inline>
      document.querySelectorAll('[data-tenure-start]').forEach((el) => {
        var start = new Date(el.getAttribute('data-tenure-start'));
        var years = (Date.now() - start.getTime()) / (365.25 * 24 * 60 * 60 * 1000);
        el.textContent = years.toFixed(1);
      });
    </script>
  </body>
</html>
