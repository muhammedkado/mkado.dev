---
import '../styles/global.css';
import { profile } from '../data/site';
import { t, type Lang } from '../lib/i18n';
// Hashed URLs of the self-hosted font files, for <link rel=preload> (they are the LCP fonts).
import bricolageWoff from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import instrumentWoff from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>; // hreflang pairs for pages that exist in both languages
  title?: string;
  description?: string;
  ogImage?: string; // absolute or site-relative; defaults to /og.png
  jsonLd?: Record<string, unknown>; // replaces the default Person graph on sub-pages
}

const {
  lang = 'en',
  alternates,
  ogImage,
  jsonLd: jsonLdProp,
  title = `${profile.name} — ${profile.title}`,
  description = 'Computer engineer in İstanbul, full-stack PHP/Laravel/React. Building RFID laundry-management software at USTEK since 2023, used in 30+ countries. Seven live demos you can open, signed in with one click.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? profile.siteUrl).toString();
const og = new URL(ogImage ?? '/og.png', Astro.site ?? profile.siteUrl).toString();

const jsonLd = jsonLdProp ?? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: profile.siteUrl,
  address: { '@type': 'PostalAddress', addressLocality: 'İstanbul', addressCountry: 'TR' },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['PHP', 'Laravel', 'React', 'MySQL', 'PostgreSQL', 'RFID systems'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && Object.entries(alternates).map(([l, path]) => <link rel="alternate" hreflang={l} href={new URL(path, Astro.site ?? profile.siteUrl).toString()} />)}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site ?? profile.siteUrl).toString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Engineering notes — Muhammed Kado" href="/rss.xml" />
    <link rel="preload" href={bricolageWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentWoff} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammed Kado, Computer Engineer in İstanbul: I build the web side of RFID systems that run in 30+ countries. Seven live demos." />
    <meta property="og:site_name" content="mkado.dev" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    {alternates && lang === 'en' && alternates.tr && <meta property="og:locale:alternate" content="tr_TR" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content="Muhammed Kado, Computer Engineer: seven live demos you can open." />
    <meta name="theme-color" content="#f7f7f5" />


    <script is:inline>
      // Mark JS as available (the timeline reveals rely on it) and apply the
      // saved theme before first paint. System preference is the default.
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#0b0f17'); // URL bar on Android follows the page background
        }
      } catch (e) {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <div id="a11y-live" class="sr-only" aria-live="polite"></div>
    <slot />

    <script is:inline>
      // Live tenure: recompute on every load so it keeps ticking between deploys,
      // and count it up once on first paint.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('[data-tenure-start]').forEach(function (el) {
          var start = new Date(el.getAttribute('data-tenure-start'));
          var years = (Date.now() - start.getTime()) / (365.25 * 24 * 60 * 60 * 1000);
          var final = years.toFixed(1);
          if (!el.hasAttribute('data-countup') || reduce) {
            el.textContent = final;
            return;
          }
          el.textContent = '0.0';
          setTimeout(function () {
            var t0 = performance.now();
            var dur = 1100;
            function tick(now) {
              var p = Math.min(1, (now - t0) / dur);
              var e = 1 - Math.pow(1 - p, 3);
              el.textContent = (years * e).toFixed(1);
              if (p < 1) requestAnimationFrame(tick);
              else el.textContent = final;
            }
            requestAnimationFrame(tick);
          }, 500);
        });

        // Copy-to-clipboard for any button.copy[data-copy].
        document.addEventListener('click', function (ev) {
          var btn = ev.target.closest('button.copy[data-copy]');
          if (!btn) return;
          navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function () {
            var tr = document.documentElement.lang === 'tr';
            var original = btn.textContent;
            btn.textContent = tr ? 'kopyalandı' : 'copied';
            btn.classList.add('copied');
            var live = document.getElementById('a11y-live');
            if (live) live.textContent = tr ? 'Panoya kopyalandı' : 'Copied to clipboard';
            setTimeout(function () {
              btn.textContent = original;
              btn.classList.remove('copied');
            }, 1200);
          }).catch(function () {});
        });
      })();
    </script>
    <script>
      import '../scripts/main-motion';
      import '../scripts/status';
    </script>
    {/* Cloudflare Web Analytics: cookieless page views, production builds only. The token is a public beacon id. */}
    {import.meta.env.PROD && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: '31926c9ee1414970908a9b0c753ffe75' })}></script>}
  </body>
</html>
