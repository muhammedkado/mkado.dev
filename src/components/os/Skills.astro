---
import Window from './Window.astro';
import T from './T.astro';
import { skills } from '../../data/site';
import { tr } from '../../data/tr';

// One line of plain English per group, for readers who don't code.
const explain: Record<string, string> = {
  'Back end': 'the server side: the logic and data behind the screens',
  'Front end': 'what people see and click in the browser',
  Data: 'databases: where the information lives',
  'Cloud & tools': 'hosting, and the tooling that ships the code',
  Domain: 'the industry knowledge I bring',
  Mobile: 'phone apps',
};
---

<Window id="skills" file="skills.manifest" en="What I work with, each group explained for non-programmers" tr="Neyle çalışıyorum, her grup programcı olmayanlar için açıklanmış">
  {skills.map((g) => (
    <div class="group">
      <p>
        <span class="k"><T en={g.group.toLowerCase()} tr={tr.skills.groups[g.group] ?? g.group.toLowerCase()} /></span>
        <span class="explain"># <T en={explain[g.group] ?? ''} tr={tr.skills.explain[g.group] ?? ''} /></span>
      </p>
      <p class="items">{g.items.map((item) => <span>{item}</span>)}</p>
    </div>
  ))}
  <p class="m"><T en="Day to day at USTEK: PHP, Laravel, Zend Framework 1, MySQL and REST APIs, against real RFID hardware." tr={tr.skills.note} /></p>
</Window>
