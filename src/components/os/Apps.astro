---
import Window from './Window.astro';
import T from './T.astro';
import { demos, demosLive } from '../../data/site';
import { tr } from '../../data/tr';
import { Picture } from 'astro:assets';
// Dashboard screenshots captured by scripts/shots.mjs; a demo without one just renders no image.
// Case-study pages exist for the slugs that have a file in src/content/work.
const studies = new Set(Object.keys(import.meta.glob('../../content/work/*.md')).map((p) => p.split('/').pop()!.replace('.md', '')));
const shotModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/shots/*.png', { eager: true });
const shots = Object.fromEntries(Object.entries(shotModules).map(([p, m]) => [p.split('/').pop()!.replace('.png', ''), m.default]));
---

<Window id="apps" file="~/apps" en="Things I built that you can try right now (nothing to install: click Open)" tr="Hemen deneyebileceğiniz, yaptığım uygulamalar (kurulum yok: Aç'a tıklayın)">
  <p class="m">
    <T
      en={`${demos.length} applications, each running on its own server with its own database. Sign in with the demo account, change anything you like; it all resets overnight.`}
      tr={`${demos.length} uygulama, her biri kendi sunucusunda kendi veritabanıyla çalışıyor. Demo hesabıyla girin, istediğinizi değiştirin; hepsi her gece sıfırlanır.`}
    />
  </p>
  <p class={demos.every((d) => d.live ?? demosLive) ? 'g' : 'y'} data-status-pill>● <span data-status-text>{demos.every((d) => d.live ?? demosLive)
      ? <T en="all systems up" tr="tüm sistemler ayakta" />
      : <T en="deploying now: the Open buttons go live shortly" tr="yayına alınıyor: Aç düğmeleri kısa süre içinde çalışacak" />}</span>
  </p>

  {demos.map((d) => (
    <article class="app">
      <div class="app-head">
        <span class={`dot ${(d.live ?? demosLive) ? 'live' : ''}`} aria-hidden="true" data-status-dot={d.slug}></span>
        <span class="app-name">{d.name}</span>
        <span class="app-year">{d.period}</span>
      </div>
      {shots[d.slug] && (
        <a class="shot" href={d.demoUrl ?? d.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Picture src={shots[d.slug]} formats={['avif', 'webp']} widths={[640, 1280]} sizes="(max-width: 700px) 100vw, 560px" alt="" loading="lazy" decoding="async" />
        </a>
      )}
      <p class="app-desc"><T en={d.summary} tr={tr.demos[d.slug]?.summary ?? d.summary} /></p>
      <p class="app-stack"><span class="k"><T en="built with" tr="kullanılan teknolojiler" /></span> {d.stack.join(', ')}</p>

      <div class="actions">
        <a class="tbtn tbtn-primary tbtn-sm" href={d.demoUrl ?? d.url} target="_blank" rel="noopener">{d.demoUrl ? <T en={`Open ${d.name} (signed in)`} tr={`${d.name} aç (giriş yapılmış)`} /> : <T en={`Open ${d.name}`} tr={`${d.name} aç`} />}</a>
        {d.extra && <a class="tbtn tbtn-sm" href={d.extra.url} target="_blank" rel="noopener">{d.extra.label}</a>}
        {d.repo && <a class="tbtn tbtn-sm" href={d.repo} target="_blank" rel="noopener"><T en="See the code" tr="Kodu gör" /></a>}
        {studies.has(d.slug) && <a class="tbtn tbtn-sm" href={`/work/${d.slug}/`}><T en="Case study" tr="Vaka çalışması" /></a>}
      </div>

      {d.credentials.length > 0 && (
        <details class="login">
          <summary><T en="demo login (click to show)" tr="demo girişi (göstermek için tıklayın)" /></summary>
          {d.credentials.map((c) => (
            <div class="cred">
              <span class="who">{c.label}</span>
              <span class="k"><T en="email" tr="e-posta" /></span>
              <button type="button" class="copy" data-copy={c.user} title="Copy" aria-label={`Copy ${c.label} email ${c.user}`}>{c.user}</button>
              <span class="k"><T en="password" tr="şifre" /></span>
              <button type="button" class="copy" data-copy={c.pass} title="Copy" aria-label={`Copy ${c.label} password`}>{c.pass}</button>
            </div>
          ))}
        </details>
      )}

      {d.note && <p class="app-note"><T en={d.note} tr={tr.demos[d.slug]?.note ?? d.note} /></p>}
    </article>
  ))}
</Window>
