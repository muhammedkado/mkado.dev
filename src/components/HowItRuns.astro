---
// The one ink block on the page: how seven applications run on one free VM,
// with the "one server, seven cables" print. Details live at /about-this-site/.
import { Picture } from 'astro:assets';
import aboutArt from '../assets/art/about.webp';
import { demos } from '../data/site';
import { t, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
---

<section class="section how" id="how">
  <div class="wrap how-grid">
    <div>
      <h2>{s.how.h2}</h2>
      <p>{s.how.lead}</p>
      <ul class="how-facts">
        <li><b>1</b><span>{s.how.vm}</span></li>
        <li><b>{demos.length}</b><span>{s.how.apps}</span></li>
        <li><b>5</b><span>{s.how.minutes}</span></li>
      </ul>
      <a class="btn" href="/about-this-site/">{s.how.more}</a>
    </div>
    <figure class="print how-print">
      <Picture src={aboutArt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 800]} sizes="(min-width: 768px) 380px, 100vw" alt={s.how.artAlt} loading="lazy" decoding="async" />
    </figure>
  </div>
</section>
