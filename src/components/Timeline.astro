---
import { tenureYears } from '../lib/tenure';
import { t, timelineCopy, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const entries = timelineCopy(lang);
---

<section class="section" id="experience">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 data-reveal="lines">{s.timeline.h2}</h2>
        <p data-reveal="up">{s.timeline.lead}</p>
      </div>
    </div>

    <div class="timeline">
      {/* The rail fills as the list scrolls into view (CSS scroll-driven animation; still without support). */}
      <span class="tl-progress" aria-hidden="true"></span>
      <ol class="tl-list" data-reveal="rows">
        {entries.map((e) => (
          <li class={`tl-item ${e.to === 'present' ? 'is-current' : ''}`}>
            <p class="tl-when">
              <span class="years">{e.from} – {e.to === 'present' ? s.timeline.present : e.to}</span>
              {e.startDate && <span><b data-tenure-start={e.startDate}>{tenureYears(e.startDate)}</b> {s.timeline.yrs}</span>}
              <span class="kind">{s.timeline.kind[e.kind] ?? e.kind}</span>
            </p>
            <h3>{e.title}</h3>
            <p class="tl-org">
              {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.org}</a> : e.org}, {e.where}
            </p>
            <p class="tl-summary">{e.summary}</p>
            {e.bullets.length > 0 && (
              <ul class="tl-bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
