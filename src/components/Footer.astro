---
import { profile } from '../data/site';
import { t, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const year = new Date().getFullYear();
const built = new Date().toLocaleDateString(s.footer.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' });
---

<footer class="ftr">
  <div class="wrap">
    <span>© {year} {profile.name}</span>
    <span>
      {s.footer.line} {built}.
      <a href="/about-this-site/">{s.footer.about}</a>
      <span aria-hidden="true">/</span>
      <a href="/notes/">{s.footer.notes}</a>
      <span aria-hidden="true">/</span>
      <a href="https://github.com/muhammedkado/mkado.dev" target="_blank" rel="noopener">{s.footer.source}</a>
      <span aria-hidden="true">/</span>
      {s.footer.experiments}: <a href="/v2/">Swiss</a>, <a href="/v3/">mkOS</a>
    </span>
  </div>
</footer>
