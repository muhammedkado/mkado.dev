---
import { profile } from '../data/site';
const year = new Date().getFullYear();
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<footer class="ftr">
  <div class="wrap">
    <span>© {year} {profile.name}</span>
    <span>
      Static Astro site, no client frameworks. Built {built}.
      <a href="https://github.com/muhammedkado/mkado.dev" target="_blank" rel="noopener">Source</a>
      <span aria-hidden="true">/</span>
      Design experiments: <a href="/v2/">Swiss</a>, <a href="/v3/">mkOS</a>
    </span>
  </div>
</footer>
