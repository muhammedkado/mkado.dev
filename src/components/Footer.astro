---
import { execSync } from 'node:child_process';
import { profile } from '../data/site';
import { t, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const year = new Date().getFullYear();
const built = new Date().toLocaleDateString(s.footer.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' });

// Short hash of the commit being built, so the footer says exactly which version is live.
// Both the workstation deploy and GitHub CI build from a checkout; blank if git is unavailable.
let commit = '';
try {
  commit = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
} catch {}
const commitUrl = `https://github.com/muhammedkado/mkado.dev/commit/${commit}`;
---

<footer class="ftr">
  <div class="wrap">
    <nav class="ftr-links" aria-label={s.footer.nav}>
      <a href="/about-this-site/">{s.footer.about}</a>
      <a href="/notes/">{s.footer.notes}</a>
      <a href="/rss.xml">{s.footer.rss}</a>
      <a href="https://github.com/muhammedkado/mkado.dev" target="_blank" rel="noopener">{s.footer.source}</a>
      <span class="ftr-exp">
        <span class="ftr-exp-label">{s.footer.experiments}</span>
        <a href="/v2/">Swiss</a>
        <a href="/v3/">mkOS</a>
      </span>
    </nav>
    <div class="ftr-meta">
      <span>© {year} {profile.name}</span>
      <span class="ftr-build">
        <span>{s.footer.line}</span>
        {/* date + hash stay on one line; only the sentence before them wraps on phones */}
        <span class="ftr-stamp">{built}{commit && <> · <a class="commit" href={commitUrl} target="_blank" rel="noopener" title={s.footer.commit}><code>{commit}</code></a></>}</span>
      </span>
    </div>
  </div>
</footer>
