---
import { skills } from '../data/site';
---

<section id="skills">
  <div class="wrap">
    <div class="section-head">
      <h2>Skills</h2>
    </div>

    <div class="skills">
      {skills.map((g) => (
        <div class={g.group === 'Mobile' ? 'small' : ''}>
          <h3>{g.group}</h3>
          <p>{g.items.join(', ')}</p>
        </div>
      ))}
    </div>
  </div>
</section>
