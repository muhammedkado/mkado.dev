---
import { skills, demos, projects } from '../data/site';
import { t, skillGroupName, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);

// Tie each skill to the shipped work that actually uses it, so the chips are
// evidence rather than a keyword list.
const shipped = [
  ...demos.map((d) => ({ name: d.name, stack: d.stack })),
  ...projects.map((p) => ({ name: p.name, stack: p.stack })),
];

function usedIn(skill: string): string[] {
  const s = skill.toLowerCase();
  return shipped
    .filter((p) => p.stack.some((t) => t.toLowerCase().includes(s)))
    .map((p) => p.name);
}
---

<section class="section" id="skills">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{s.skills.h2}</h2>
        <p>{s.skills.lead}</p>
      </div>
    </div>

    <div class="skills">
      {skills.map((g) => (
        <div class="skill-group anim">
          <h3>{skillGroupName(g.group, lang)}</h3>
          <div class="chips">
            {g.items.map((item) => {
              const where = usedIn(item);
              return where.length > 0 ? (
                <span class="chip" title={`${s.skills.usedIn}: ${where.join(', ')}`}>
                  {item}
                  <span class="n">{where.length}</span>
                </span>
              ) : (
                <span class="chip">{item}</span>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <p class="skills-note">{s.skills.note}</p>
  </div>
</section>
