---
import { skills } from '../data/site';
---

<section id="skills">
  <div class="wrap">
    <div class="section-head">
      <h2>skills</h2>
    </div>

    <div class="skills">
      {skills.map((g) => (
        <div class="skills-row">
          <span class="k">{g.group.toLowerCase()}</span>
          <span class="chips">{g.items.map((item) => <span>{item}</span>)}</span>
        </div>
      ))}
    </div>
  </div>
</section>
