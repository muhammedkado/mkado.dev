---
import { skills, demos, projects } from '../data/site';
import { t, skillGroupName, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);

// Tie each skill to the shipped work that actually uses it: the small number
// after a skill is evidence, not a keyword list.
const shipped = [
  ...demos.map((d) => ({ name: d.name, stack: d.stack })),
  ...projects.map((p) => ({ name: p.name, stack: p.stack })),
];

function usedIn(skill: string): string[] {
  const k = skill.toLowerCase();
  return shipped.filter((p) => p.stack.some((st) => st.toLowerCase().includes(k))).map((p) => p.name);
}
---

<section class="section" id="skills">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 data-reveal="lines">{s.skills.h2}</h2>
        <p data-reveal="up">{s.skills.lead}</p>
      </div>
    </div>

    <div class="skills" data-reveal="rows">
      {skills.map((g) => (
        <div class="skill-group">
          <h3>{skillGroupName(g.group, lang)}</h3>
          <ul class="skill-list">
            {g.items.map((item) => {
              const where = usedIn(item);
              return where.length > 0 ? (
                <li class="skill" title={`${s.skills.usedIn}: ${where.join(', ')}`}>
                  {item}<sup class="n">{where.length}</sup>
                </li>
              ) : (
                <li class="skill">{item}</li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <p class="skills-note">{s.skills.note}</p>
  </div>
</section>
