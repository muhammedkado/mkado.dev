---
import { skills, demos, projects } from '../data/site';

// Tie each skill to the shipped work that actually uses it, so the chips are
// evidence rather than a keyword list.
const shipped = [
  ...demos.map((d) => ({ name: d.name, stack: d.stack })),
  ...projects.map((p) => ({ name: p.name, stack: p.stack })),
];

function usedIn(skill: string): string[] {
  const s = skill.toLowerCase();
  return shipped
    .filter((p) => p.stack.some((t) => t.toLowerCase().includes(s)))
    .map((p) => p.name);
}
---

<section class="section" id="skills">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Skills</h2>
        <p>A number next to a skill is how many of the projects on this page ship with it. Hover to see which.</p>
      </div>
    </div>

    <div class="skills">
      {skills.map((g) => (
        <div class="skill-group anim">
          <h3>{g.group}</h3>
          <div class="chips">
            {g.items.map((item) => {
              const where = usedIn(item);
              return where.length > 0 ? (
                <span class="chip" title={`Used in: ${where.join(', ')}`}>
                  {item}
                  <span class="n">{where.length}</span>
                </span>
              ) : (
                <span class="chip">{item}</span>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <p class="skills-note">Day to day at USTEK: PHP, Laravel, Zend Framework 1, MySQL and REST APIs, against real RFID hardware.</p>
  </div>
</section>
