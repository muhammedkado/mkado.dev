---
import { profile } from '../data/site';
import { t, homeFor, langs, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const home = homeFor(lang);
---

<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="brand" href={`${home}#top`}>
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#101828"/>
        <path d="M40 14a10 10 0 0 1 10 10" fill="none" stroke="#6FD0FF" stroke-width="2.6" stroke-linecap="round" opacity="0.6"/>
        <path d="M40 8a16 16 0 0 1 16 16" fill="none" stroke="#6FD0FF" stroke-width="2.6" stroke-linecap="round" opacity="0.32"/>
        <circle cx="40" cy="24" r="3.2" fill="#6D93FF"/>
        <text x="12" y="49" font-family="'Bricolage Grotesque', system-ui, sans-serif" font-weight="700" font-size="30" letter-spacing="-1.5" fill="#F1F4F9">mk</text>
      </svg>
      <span class="name">{profile.name}</span>
      <span class="pip" title={s.openToWork} aria-hidden="true"></span>
    </a>

    <nav class="nav" id="site-nav" aria-label={s.nav.sections}>
      <a href={`${home}#work`}>{s.nav.work}</a>
      <a href={`${home}#experience`}>{s.nav.experience}</a>
      <a href={`${home}#skills`}>{s.nav.skills}</a>
      <a href={`${home}#contact`}>{s.nav.contact}</a>
    </nav>

    <div class="controls">
      {/* Both languages, current one marked. The other link gets the section hash appended on the home pages (script below). */}
      <nav class="lang" aria-label={s.lang.label}>
        {langs.map((l) => (
          <a href={homeFor(l)} hreflang={l} lang={l} title={s.lang[l]} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <button class="toggle" type="button" id="theme-toggle" aria-label={s.theme.toDark} title={s.theme.toDark} data-to-dark={s.theme.toDark} data-to-light={s.theme.toLight}>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="toggle menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label={s.menu.open} title={s.menu.open} data-open={s.menu.open} data-close={s.menu.close}>
        <svg class="bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const hdr = document.getElementById('hdr');

  // Theme: data attribute + the URL-bar colour + a label that says what the button will do.
  const toggle = document.getElementById('theme-toggle');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const isDark = () => root.getAttribute('data-theme') === 'dark';
  const labelTheme = () => {
    if (!toggle) return;
    const label = isDark() ? toggle.dataset.toLight : toggle.dataset.toDark;
    if (label) {
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    }
  };
  labelTheme();
  toggle?.addEventListener('click', () => {
    const dark = !isDark();
    if (dark) root.setAttribute('data-theme', 'dark');
    else root.removeAttribute('data-theme');
    if (themeMeta) themeMeta.content = dark ? '#0b0f17' : '#f7f7f5';
    labelTheme();
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  // Hairline under the header once the page has scrolled.
  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu: a disclosure (no focus trap). Closes on link click, Escape, or when the viewport grows.
  const menuBtn = document.getElementById('menu-btn');
  const nav = document.getElementById('site-nav');
  const menuOpen = () => hdr?.classList.contains('is-open') ?? false;
  const setMenu = (open: boolean) => {
    hdr?.classList.toggle('is-open', open);
    if (!menuBtn) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    const label = open ? menuBtn.dataset.close : menuBtn.dataset.open;
    if (label) {
      menuBtn.setAttribute('aria-label', label);
      menuBtn.title = label;
    }
  };
  menuBtn?.addEventListener('click', () => setMenu(!menuOpen()));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen()) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  // Scroll-spy on the home pages. The links are "/#id" or "/tr/#id", so match on pathname + hash.
  const local = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a')).filter(
    (a) => a.hash && new URL(a.href).pathname === location.pathname,
  );
  const targets = local
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((el): el is HTMLElement => el !== null);
  const otherLang = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lang a:not([aria-current])'));
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const hash = `#${e.target.id}`;
          local.forEach((a) => {
            const on = a.hash === hash;
            a.classList.toggle('is-active', on);
            if (on) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
          // The other language opens at the section being read (/#work -> /tr/#work).
          otherLang.forEach((a) => {
            a.hash = hash;
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
