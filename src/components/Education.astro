---
import { education, languages } from '../data/site';
---

<section id="education">
  <div class="wrap">
    <div class="facts">
      <div>
        <h3>education</h3>
        <p class="big">{education.degree}</p>
        <p class="sub">{education.school}, {education.period}</p>
      </div>
      <div>
        <h3>languages</h3>
        <ul>
          {languages.map((l) => (
            <li><span>{l.name}</span><span>{l.level}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
