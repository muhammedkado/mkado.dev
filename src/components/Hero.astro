---
import { profile } from '../data/site';
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="identity">
      <div class="identity-head">
        <span class="who">{profile.name} <span class="at">· {profile.title}</span></span>
        <span class="status">
          <span class="dot" aria-hidden="true"></span>
          open to work
        </span>
      </div>
      <div class="fields">
        <div class="field"><span class="k">stack</span><span class="v">{profile.stackLine}</span></div>
        <div class="field"><span class="k">location</span><span class="v">{profile.location}</span></div>
        <div class="field"><span class="k">contact</span><span class="v"><a href={`mailto:${profile.email}`}>{profile.email}</a></span></div>
      </div>
    </div>

    <h1>{profile.headline}</h1>
    <p class="intro">{profile.intro}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#demos">Open the live demos</a>
      <a class="btn" href={profile.cv} download="Muhammed_Kado_CV.pdf">Download CV</a>
      <span class="textlinks">
        <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
        <span class="sep">/</span>
        <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </span>
    </div>
  </div>
</section>
