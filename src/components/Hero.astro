---
import { profile, experience, education } from '../data/site';
import { tenureYears } from '../lib/tenure';
import Reader from './Reader.astro';

const tenure = tenureYears(experience.startDate);
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <p class="kicker rise" style="--delay: 0.05s">
        <strong>{profile.name}</strong>
        <span class="sep" aria-hidden="true">/</span>
        <span>{profile.title}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span>{profile.role}</span>
      </p>

      <h1 class="rise" style="--delay: 0.15s">{profile.headline}</h1>
      <p class="lede rise" style="--delay: 0.28s">{profile.intro}</p>

      <div class="cta rise" style="--delay: 0.4s">
        <a class="btn btn-primary" href="#work">See the live work</a>
        <a class="btn" href={profile.cv} download="Muhammed_Kado_CV.pdf">Download CV</a>
        <span class="textlinks">
          <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </span>
      </div>

      <p class="facts rise" style="--delay: 0.5s">
        <span><b data-tenure-start={experience.startDate} data-countup>{tenure}</b> years at {experience.company}</span>
        <span><b>{education.degree}</b>, {education.period}</span>
        <span>{profile.location}</span>
      </p>
    </div>

    <div class="reader-wrap rise" style="--delay: 0.2s">
      <Reader />
      <p class="readout">
        <span>UHF RFID</span>
        <span>readers, terminals, web platform</span>
        <span>30+ countries</span>
      </p>
    </div>
  </div>
</section>
