---
import { Picture } from 'astro:assets';
import heroArt from '../assets/art/hero.webp';
import { profile, experience, demos, languages } from '../data/site';
import { tenureYears } from '../lib/tenure';
import { t, profileCopy, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const p = profileCopy(lang);
const tenure = tenureYears(experience.startDate);
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="kicker rise" style="--delay: 0.05s">{p.title}, {s.hero.city}</p>
      <h1 class="rise" style="--delay: 0.12s">{p.headline}</h1>
      <p class="lede rise" style="--delay: 0.24s">{p.intro}</p>

      <div class="cta rise" style="--delay: 0.34s">
        <a class="btn btn-primary" href="#work">{s.hero.seeWork}</a>
        <a class="btn" href={profile.cv} download="Muhammed_Kado_CV.pdf">{s.hero.downloadCv}</a>
        <span class="textlinks">
          <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </span>
      </div>

      <ul class="facts rise" style="--delay: 0.44s">
        <li><b data-tenure-start={experience.startDate} data-countup>{tenure}</b><span>{s.hero.facts.tenure}</span></li>
        <li><b>{demos.length}</b><span>{s.hero.facts.apps}</span></li>
        <li><b>30+</b><span>{s.hero.facts.countries}</span></li>
        <li><b>{languages.length}</b><span>{s.hero.facts.languages}</span></li>
      </ul>
    </div>

    {/* The print prints itself on load (clip-path), then the reader pulses once: global.css .hero-print / .pulse */}
    <figure class="print hero-print rise" style="--delay: 0.18s">
      <Picture src={heroArt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[560, 900, 1400]} sizes="(min-width: 768px) 42vw, 100vw" alt={s.hero.artAlt} loading="eager" fetchpriority="high" decoding="async" />
      <svg class="pulse" viewBox="0 0 100 75" aria-hidden="true">
        <circle cx="27" cy="39" r="34" />
        <circle cx="27" cy="39" r="34" />
      </svg>
    </figure>
  </div>
</section>
