---
// The one ink block on the page: the day job in plain words, told as the path
// of one RFID read (tag -> reader -> platform); the platform is the part I build.
// The rail fills and each step lights as the read reaches it (home-motion.ts);
// without that script every step is shown lit. How this site itself runs lives
// at /about-this-site/ (footer).
import { t, homeFor, type Lang } from '../lib/i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang).readpath;
const last = s.steps.length - 1;

// 24px stroke icons (docs/brand-guidelines.md §6): a laundry tag, a handheld reader, the platform.
const icons = [
  '<path d="M4 4h8.5l7.5 7.5-8.5 8.5L4 12.5z"/><circle cx="8.5" cy="8.5" r="1.5"/>',
  '<rect x="3" y="9" width="10" height="6" rx="1.5"/><path d="M16 9.5a3.5 3.5 0 0 1 0 5M19 7a7 7 0 0 1 0 10"/>',
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 13h6M7 16h9"/>',
];
---

<section class="section ink" id="rfid">
  <div class="wrap">
    <div class="ink-head">
      <h2 data-reveal="lines">{s.h2}</h2>
      <p data-reveal="up">{s.lead}</p>
    </div>

    <ol class="readpath" data-reveal="rows" style={`--n: ${s.steps.length}`}>
      {s.steps.map((step, i) => (
        <li class={`rp-step${i === last ? ' is-mine' : ''}`} style={`--i: ${i}`}>
          <span class="rp-node" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={icons[i]} /></svg>
          </span>
          <div class="rp-text">
            <h3>{step.title}</h3>
            {i === last && <span class="rp-mine">{s.mine}</span>}
            <p>{step.body}</p>
            <p class="rp-tech">{step.tech}</p>
          </div>
        </li>
      ))}
    </ol>

    <a class="btn" href={`${homeFor(lang)}#experience`}>{s.more}</a>
  </div>
</section>
