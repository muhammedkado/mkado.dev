---
const items = [
  {
    title: 'Back ends that run in production',
    text: 'PHP, Laravel and Zend Framework, REST APIs on MySQL and PostgreSQL, shipped to hotels, hospitals and commercial laundries in 30+ countries.',
    icon: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  },
  {
    title: 'Interfaces people actually use',
    text: 'React, Blade and Alpine.js admin panels and PWAs, in English, Arabic and Kurdish, with proper right-to-left layouts.',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  },
  {
    title: 'Comfortable next to hardware',
    text: 'The web side of UHF RFID readers and terminals: keeping data flowing reliably between devices and the platform, with the hardware team.',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/>',
  },
];
---

<section class="section" aria-labelledby="strengths-title">
  <div class="wrap">
    <div class="section-head anim">
      <h2 id="strengths-title">What I bring</h2>
      <p>Three years of shipping features for a platform that businesses depend on every day, plus a computer-engineering degree behind it.</p>
    </div>
    <div class="strengths">
      {items.map((s) => (
        <article class="strength anim">
          <div class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
