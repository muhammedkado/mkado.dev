---
import { profile, experience, demos, languages } from '../../data/site';
import { tenureYears } from '../../lib/tenure';

const tenure = tenureYears(experience.startDate);
const spoken = languages.map((l) => l.name).join(', ');
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow anim"><b>{profile.title}</b>, {profile.role}</p>
      <h1 class="anim">{profile.headline}</h1>
      <p class="lede anim">{profile.intro}</p>
      <div class="cta-row">
        <a class="btn btn-primary anim" href="#work">See the live work</a>
        <a class="btn btn-secondary anim" href={profile.cv} download="Muhammed_Kado_CV.pdf">Download CV</a>
      </div>
      <p class="hero-links">
        <a class="anim" href={profile.github} target="_blank" rel="noopener">GitHub</a>
        <a class="anim" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>

    <ul class="facts">
      <li class="fact anim">
        <b data-tenure-start={experience.startDate}>{tenure}</b>
        <span>years at {experience.company}, since 2023</span>
      </li>
      <li class="fact anim">
        <b data-count={demos.length}>{demos.length}</b>
        <span>live applications you can sign into</span>
      </li>
      <li class="fact anim">
        <b data-count="30" data-suffix="+">30+</b>
        <span>countries running software I work on</span>
      </li>
      <li class="fact anim">
        <b data-count={languages.length}>{languages.length}</b>
        <span>languages: {spoken}</span>
      </li>
    </ul>
  </div>
</section>
