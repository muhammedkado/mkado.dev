---
import { demos, demosLive, projects } from '../../data/site';

type Card = {
  key: string;
  name: string;
  summary: string;
  stack: string[];
  url: string | null;
  repo: string | null;
  extra?: { label: string; url: string };
  creds: { label: string; user: string; pass: string }[];
  note?: string;
  period: string;
  status: 'live' | 'soon' | 'code';
};

const cards: Card[] = [
  ...demos.map((d) => ({
    key: d.slug,
    name: d.name,
    summary: d.summary,
    stack: d.stack,
    url: d.url,
    repo: d.repo,
    extra: d.extra,
    creds: d.credentials,
    note: d.note,
    period: d.period,
    status: ((d.live ?? demosLive) ? 'live' : 'soon') as Card['status'],
  })),
  ...projects.map((p) => ({
    key: p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    name: p.name,
    summary: p.summary,
    stack: p.stack,
    url: p.url,
    repo: p.repo,
    creds: [],
    period: '',
    status: (p.live ? 'live' : 'code') as Card['status'],
  })),
];

function cats(stack: string[]): string[] {
  const s = stack.join(' ').toLowerCase();
  const c: string[] = [];
  if (s.includes('laravel')) c.push('laravel');
  if (s.includes('react')) c.push('react');
  if (s.includes('php') && !s.includes('laravel')) c.push('php');
  if (s.includes('flutter')) c.push('flutter');
  return c.length ? c : ['other'];
}

const filters = [
  { key: 'all', label: 'All' },
  { key: 'laravel', label: 'Laravel' },
  { key: 'react', label: 'React' },
  { key: 'php', label: 'Plain PHP' },
  { key: 'flutter', label: 'Flutter' },
];

const statusLabel = { live: 'live', soon: 'deploying', code: 'source only' };
---

<section class="section" id="work">
  <div class="wrap">
    <div class="work-head">
      <div class="section-head anim" style="margin-bottom: 0">
        <h2>Work you can open</h2>
        <p>Five real deployments, each with its own database, plus a few side projects. Sign in with the demo accounts and change whatever you like; everything resets overnight.</p>
      </div>
      <span class={`status-pill ${demos.every((d) => d.live ?? demosLive) ? '' : 'soon'}`}>
        <span class={`dot ${demos.every((d) => d.live ?? demosLive) ? 'live' : ''}`} aria-hidden="true"></span>
        {demos.every((d) => d.live ?? demosLive) ? 'All demos up' : `${demos.filter((d) => d.live ?? demosLive).length} of ${demos.length} demos up`}
      </span>
    </div>

    <div class="filters" role="group" aria-label="Filter projects by technology">
      {filters.map((f) => (
        <button type="button" class="chip" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
      ))}
    </div>

    <div class="grid" id="work-grid">
      {cards.map((c) => (
        <article class="card anim" data-cats={cats(c.stack).join(' ')}>
          <div class="card-head">
            <h3>{c.name}</h3>
            <span class="card-status">
              <span class={`dot ${c.status === 'live' ? 'live' : ''}`} aria-hidden="true"></span>
              {statusLabel[c.status]}{c.period && `, ${c.period}`}
            </span>
          </div>
          <p>{c.summary}</p>
          <div class="stack">{c.stack.map((s) => <span>{s}</span>)}</div>

          <div class="card-actions">
            {c.url && (
              <a class="btn btn-primary btn-sm" href={c.url} target="_blank" rel="noopener">
                Open
                <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            )}
            {c.extra && <a class="btn btn-secondary btn-sm" href={c.extra.url} target="_blank" rel="noopener">{c.extra.label}</a>}
            {c.repo && <a class="btn btn-secondary btn-sm" href={c.repo} target="_blank" rel="noopener">Code</a>}
          </div>

          {c.creds.length > 0 && (
            <details class="login">
              <summary>Demo sign-in details</summary>
              {c.creds.map((cr) => (
                <div class="cred">
                  <span class="who">{cr.label}</span>
                  <span class="k">email</span>
                  <button type="button" class="copy" data-copy={cr.user} title="Copy">{cr.user}</button>
                  <span class="k">password</span>
                  <button type="button" class="copy" data-copy={cr.pass} title="Copy">{cr.pass}</button>
                </div>
              ))}
            </details>
          )}

          {c.note && <p class="note">{c.note}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Filtering (with FLIP position animation) lives in src/scripts/swiss-motion.ts so GSAP ships once. -->
