---
import { demos, demosLive } from '../data/site';
import { t, demoCopy, type Lang } from '../lib/i18n';
import { Picture } from 'astro:assets';
// Dashboard screenshots captured by scripts/shots.mjs; a demo without one just renders no frame.
const shotModules = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const shots = Object.fromEntries(Object.entries(shotModules).map(([p, m]) => [p.split('/').pop()!.replace('.png', ''), m.default]));
// One two-ink print per application (scripts/art.mjs -> src/assets/art/spot-<slug>.webp).
const spotModules = import.meta.glob<{ default: ImageMetadata }>('../assets/art/spot-*.webp', { eager: true });
const spots = Object.fromEntries(Object.entries(spotModules).map(([p, m]) => [p.split('/').pop()!.replace(/^spot-|\.webp$/g, ''), m.default]));

// Case-study pages exist for the slugs that have a file in src/content/work.
const studies = new Set(Object.keys(import.meta.glob('../content/work/*.md')).map((p) => p.split('/').pop()!.replace('.md', '')));
const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const isLive = (d: (typeof demos)[number]) => d.live ?? demosLive;
const allLive = demos.every(isLive);
---

<section class="section" id="work">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 data-reveal="lines">{s.showcase.h2}</h2>
        <p data-reveal="up">{s.showcase.lead}</p>
      </div>
      {/* data-status-* : src/scripts/status.ts swaps in the live 5-minute probe (/status.json) */}
      <span class={`status ${allLive ? '' : 'soon'}`} data-status-pill>
        <span class="dot" aria-hidden="true"></span>
        <span data-status-text>{allLive ? s.showcase.allUp : s.showcase.someUp(demos.filter(isLive).length, demos.length)}</span>
      </span>
    </div>

    {/* Every application is one row; the first is open so the page shows a screenshot at once. Native <details>: keyboard and no JS. */}
    <div class="catalog" data-reveal="rows">
      {demos.map((d, i) => {
        const copy = demoCopy(d, lang);
        const open = d.demoUrl ?? d.url;
        return (
          <details class="item" id={`app-${d.slug}`} open={i === 0}>
            <summary>
              <span class="spot">{spots[d.slug] && <Picture src={spots[d.slug]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[192, 384]} sizes="96px" alt="" loading="lazy" decoding="async" />}</span>
              <span class="item-main">
                <h3 class="item-name">{d.name}</h3>
                <span class="item-line">{copy.summary}</span>
              </span>
              <span class="item-meta">
                <span class="item-status"><span class="dot" aria-hidden="true" data-status-dot={d.slug}></span>{d.period}</span>
                <span class="item-toggle" aria-hidden="true"></span>
              </span>
            </summary>

            <div class="item-body">
              {shots[d.slug] && (
                <a class="frame" href={open} target="_blank" rel="noopener" aria-label={`${s.showcase.open(d.name)}${d.demoUrl ? s.showcase.signedIn : ''}`}>
                  <Picture src={shots[d.slug]} formats={['avif', 'webp']} widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 520px" alt="" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="item-text">
                <p class="stack-line">{s.showcase.stackLabel} {d.stack.join(', ')}.</p>

                <div class="actions">
                  <a class="btn btn-primary btn-sm" href={open} target="_blank" rel="noopener">{s.showcase.open(d.name)}{d.demoUrl && s.showcase.signedIn}</a>
                  {d.extra && <a class="btn btn-sm" href={d.extra.url} target="_blank" rel="noopener">{d.extra.label}</a>}
                  {studies.has(d.slug) && <a class="btn btn-sm" href={`${lang === 'tr' ? '/tr' : ''}/work/${d.slug}/`}>{s.showcase.caseStudy}</a>}
                  {d.repo && <a class="btn btn-sm" href={d.repo} target="_blank" rel="noopener">{s.showcase.source}</a>}
                </div>

                {d.credentials.length > 0 && (
                  <div class="creds">
                    {d.credentials.map((c) => (
                      <div class="cred">
                        <span class="who">{c.label}</span>
                        <span class="k">{s.showcase.email}</span>
                        <button type="button" class="copy" data-copy={c.user} title="Copy" aria-label={`Copy ${c.label} email ${c.user}`}>{c.user}</button>
                        <span class="k">{s.showcase.password}</span>
                        <button type="button" class="copy" data-copy={c.pass} title="Copy" aria-label={`Copy ${c.label} password`}>{c.pass}</button>
                      </div>
                    ))}
                  </div>
                )}

                {copy.note && <p class="item-note">{copy.note}</p>}
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>
