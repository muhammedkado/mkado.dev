---
import { demos, demosLive } from '../data/site';
import { t, demoCopy, type Lang } from '../lib/i18n';
import { Picture } from 'astro:assets';
// Dashboard screenshots captured by scripts/shots.mjs; a demo without one just renders no image.
const shotModules = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const shots = Object.fromEntries(Object.entries(shotModules).map(([p, m]) => [p.split('/').pop()!.replace('.png', ''), m.default]));

// Case-study pages exist for the slugs that have a file in src/content/work.
const studies = new Set(Object.keys(import.meta.glob('../content/work/*.md')).map((p) => p.split('/').pop()!.replace('.md', '')));
const { lang = 'en' } = Astro.props as { lang?: Lang };
const s = t(lang);
const isLive = (d: (typeof demos)[number]) => d.live ?? demosLive;
const allLive = demos.every(isLive);
---

<section class="section" id="work">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{s.showcase.h2}</h2>
        <p>{s.showcase.lead}</p>
      </div>
      {/* data-status-* : src/scripts/status.ts swaps in the live 5-minute probe (/status.json) */}
      <span class={`status ${allLive ? '' : 'soon'}`} data-status-pill>
        <span class="dot" aria-hidden="true"></span>
        <span data-status-text>{allLive ? s.showcase.allUp : s.showcase.someUp(demos.filter(isLive).length, demos.length)}</span>
      </span>
    </div>

    <div class="showcase">
      <div class="tabs" role="tablist" aria-label={s.showcase.tablist} aria-orientation="vertical">
        {demos.map((d, i) => (
          <button
            class={`tab ${isLive(d) ? 'is-live' : ''}`}
            role="tab"
            type="button"
            id={`tab-${d.slug}`}
            aria-controls={`panel-${d.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="dot" aria-hidden="true" data-status-dot={d.slug}></span>
            <span class="name">{d.name}</span>
            <span class="meta">{d.stack[0]}</span>
          </button>
        ))}
      </div>

      <div class="panels">
        {demos.map((d, i) => (
          <div class="panel" role="tabpanel" id={`panel-${d.slug}`} aria-labelledby={`tab-${d.slug}`} hidden={i !== 0} tabindex="0">
            <div class="panel-head">
              <h3>{d.name}</h3>
              <span class="period">{d.period}</span>
            </div>
            {shots[d.slug] && (
              <a class="shot" href={d.demoUrl ?? d.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <Picture src={shots[d.slug]} formats={['avif', 'webp']} widths={[640, 1280]} sizes="(max-width: 860px) 100vw, 640px" alt="" loading="lazy" decoding="async" />
              </a>
            )}
            <p class="summary">{demoCopy(d, lang).summary}</p>
            <div class="stack">{d.stack.map((s) => <span>{s}</span>)}</div>

            <div class="panel-actions">
              <a class="btn btn-primary btn-sm" href={d.demoUrl ?? d.url} target="_blank" rel="noopener">{s.showcase.open(d.name)}{d.demoUrl && s.showcase.signedIn}</a>
              {d.extra && <a class="btn btn-sm" href={d.extra.url} target="_blank" rel="noopener">{d.extra.label}</a>}
              {d.repo && <a class="btn btn-sm" href={d.repo} target="_blank" rel="noopener">{s.showcase.source}</a>}
              {studies.has(d.slug) && <a class="btn btn-sm" href={`/work/${d.slug}/`}>{s.showcase.caseStudy}</a>}
            </div>

            {d.credentials.length > 0 && (
              <div class="creds">
                {d.credentials.map((c) => (
                  <div class="cred">
                    <span class="who">{c.label}</span>
                    <span class="k">{s.showcase.email}</span>
                    <button type="button" class="copy" data-copy={c.user} title="Copy" aria-label={`Copy ${c.label} email ${c.user}`}>{c.user}</button>
                    <span class="k">{s.showcase.password}</span>
                    <button type="button" class="copy" data-copy={c.pass} title="Copy" aria-label={`Copy ${c.label} password`}>{c.pass}</button>
                  </div>
                ))}
              </div>
            )}

            {demoCopy(d, lang).note && <p class="note">{demoCopy(d, lang).note}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (ev) => {
        const i = tabs.indexOf(tab);
        let j: number | null = null;
        if (ev.key === 'ArrowDown' || ev.key === 'ArrowRight') j = (i + 1) % tabs.length;
        if (ev.key === 'ArrowUp' || ev.key === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
        if (ev.key === 'Home') j = 0;
        if (ev.key === 'End') j = tabs.length - 1;
        if (j === null) return;
        ev.preventDefault();
        tabs[j].focus();
        select(tabs[j]);
      });
    });
  });
</script>
