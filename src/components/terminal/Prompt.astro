---
import { profile } from '../../data/site';
const commands = ['help', 'apps', 'experience', 'skills', 'contact', 'cv', 'theme', 'clear'];
---

<section class="cmd" id="prompt">
  <h2 class="comment"># 6. Your turn: type a command and press Enter, or just click one</h2>
  <div class="chips">
    {commands.map((c) => <button type="button" data-run={c}>{c}</button>)}
  </div>
  <div class="line">
    <span class="prompt">muhammed@mkado:<span class="path">~</span>$</span>
    <input class="input" id="cli" type="text" aria-label="Type a command" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="help" />
  </div>
  <div class="replies" id="replies" aria-live="polite"></div>
</section>

<script define:vars={{ cv: profile.cv, email: profile.email }}>
  var input = document.getElementById('cli');
  var out = document.getElementById('replies');

  var help = [
    'help         this list',
    'apps         the five applications you can try',
    'experience   where I have worked and studied',
    'skills       what I work with',
    'contact      email and links',
    'cv           download my CV (PDF)',
    'theme        switch light / dark',
    'clear        clear this area',
  ].join('\n');

  var jump = {
    apps: '#apps', demos: '#apps', work: '#apps', projects: '#apps',
    experience: '#experience', skills: '#skills', contact: '#contact',
    whoami: '#whoami', about: '#whoami',
  };

  function print(cmd, text, err) {
    var div = document.createElement('div');
    div.className = 'reply' + (err ? ' err' : '');
    var echo = document.createElement('span');
    echo.className = 'echo';
    echo.textContent = '$ ' + cmd + '\n';
    div.append(echo, text);
    out.append(div);
  }

  function run(raw) {
    var cmd = raw.trim().toLowerCase();
    if (!cmd) return;
    if (cmd === 'help' || cmd === '?') print(cmd, help);
    else if (cmd === 'clear') out.replaceChildren();
    else if (cmd === 'cv') { print(cmd, 'Opening the CV (PDF).'); window.open(cv, '_blank'); }
    else if (cmd === 'theme') { var t = document.getElementById('theme-toggle'); if (t) t.click(); print(cmd, 'Theme switched.'); }
    else if (cmd === 'email') print(cmd, email);
    else if (cmd === 'hi' || cmd === 'hello' || cmd === 'hey') print(cmd, 'Hello! Type help to see what you can do here.');
    else if (cmd === 'merhaba' || cmd === 'selam') print(cmd, 'Merhaba! Türkçe de olur. help yazın, komutları göstereyim.');
    else if (cmd === 'مرحبا' || cmd === 'سلام') print(cmd, 'أهلاً! اكتب help لعرض الأوامر.');
    else if (jump[cmd]) {
      print(cmd, 'Jumping to ' + cmd + '.');
      var el = document.querySelector(jump[cmd]);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    } else print(cmd, 'Command not found: ' + cmd + '. Try: help', true);
  }

  input.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter') return;
    run(input.value);
    input.value = '';
  });

  document.querySelectorAll('[data-run]').forEach(function (b) {
    b.addEventListener('click', function () {
      input.value = '';
      run(b.getAttribute('data-run'));
      input.focus();
    });
  });
</script>
