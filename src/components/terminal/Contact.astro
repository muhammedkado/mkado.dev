---
import { profile, languages } from '../../data/site';
import Cmd from './Cmd.astro';

const names = languages.map((l) => l.name);
const spoken = `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
---

<Cmd id="contact" n={5} title="Get in touch" cmd="contact --all">
  <p class="status"><span class="dot" aria-hidden="true"></span>open to full-time roles, remote or in İstanbul</p>
  <p>
    <span class="k">email</span>
    <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <button type="button" class="copy" data-copy={profile.email}>copy</button>
  </p>
  <div class="links">
    <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
    <a href={profile.whatsapp} target="_blank" rel="noopener">WhatsApp {profile.phone}</a>
    <a href={profile.cv} download="Muhammed_Kado_CV.pdf">CV (PDF)</a>
  </div>
  <p class="m">I read {spoken}: write in whichever is easiest for you.</p>
</Cmd>
