---
import OS from '../layouts/OS.astro';
import Boot from '../components/os/Boot.astro';
import MenuBar from '../components/os/MenuBar.astro';
import About from '../components/os/About.astro';
import Apps from '../components/os/Apps.astro';
import Career from '../components/os/Career.astro';
import Skills from '../components/os/Skills.astro';
import Contact from '../components/os/Contact.astro';
import Terminal from '../components/os/Terminal.astro';
import Trash from '../components/os/Trash.astro';
import Dock from '../components/os/Dock.astro';
import Spotlight from '../components/os/Spotlight.astro';
import Shutdown from '../components/os/Shutdown.astro';
import T from '../components/os/T.astro';
import { profile } from '../data/site';

const year = new Date().getFullYear();
---

<OS>
  <Boot />
  <MenuBar />

  <main class="desktop">
    <About />
    <Apps />
    <div class="desk-col"><Career /></div>
    <div class="desk-col">
      <Skills />
      <Contact />
      <Terminal />
    </div>
    <Trash />
  </main>

  <p class="foot">
    <span>© {year} {profile.name}, mkOS 2026.09</span>
    <a href="/"><T en="See the standard version of this site" tr="Sitenin standart sürümüne geç" /></a>
  </p>

  <Dock />
  <Spotlight />
  <Shutdown />
</OS>
