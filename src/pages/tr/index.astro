---
// Turkish home page: the same components as / with lang="tr" (copy from
// src/lib/i18n.ts + src/data/tr.ts). Astro's i18n routing keeps / for English.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Showcase from '../../components/Showcase.astro';
import ReadPath from '../../components/ReadPath.astro';
import Timeline from '../../components/Timeline.astro';
import Skills from '../../components/Skills.astro';
import NotesStrip from '../../components/NotesStrip.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import Backdrop from '../../components/Backdrop.astro';
import { t } from '../../lib/i18n';

const s = t('tr');
---

<Base lang="tr" title={s.htmlTitle} description={s.description} alternates={{ en: '/', tr: '/tr/' }} ogImage="/og-tr.png">
  <Backdrop />
  <Header lang="tr" />
  <main id="main">
    <Hero lang="tr" />
    <Showcase lang="tr" />
    <ReadPath lang="tr" />
    <Timeline lang="tr" />
    <Skills lang="tr" />
    <NotesStrip lang="tr" />
    <Contact lang="tr" />
  </main>
  <Footer lang="tr" />
</Base>
