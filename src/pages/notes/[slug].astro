---
// One engineering note (src/content/notes/<slug>.md).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Backdrop from '../../components/Backdrop.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  const entries = (await getCollection('notes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[i - 1] ?? null, older: entries[i + 1] ?? null },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  author: { '@type': 'Person', name: profile.name, url: profile.siteUrl },
  url: new URL(Astro.url.pathname, Astro.site ?? profile.siteUrl).toString(),
  keywords: entry.data.tags.join(', '),
};
---

<Base title={`${entry.data.title} — notes`} description={entry.data.description} jsonLd={jsonLd}>
  <Backdrop />
  <Header />
  <main id="main" class="case">
    <article class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/notes/">Notes</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span>
      </nav>
      <header class="case-head">
        <p class="eyebrow"><time datetime={entry.data.date.toISOString()}>{date}</time>{entry.data.tags.length > 0 && ` · ${entry.data.tags.join(' · ')}`}</p>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
      </header>
      <section class="case-section prose note-body">
        <Content />
      </section>
      <nav class="case-nav" aria-label="Other notes">
        {older ? <a href={`/notes/${older.id}/`}><span class="k">Older</span>{older.data.title}</a> : <span />}
        {newer ? <a class="next" href={`/notes/${newer.id}/`}><span class="k">Newer</span>{newer.data.title}</a> : <span />}
      </nav>
    </article>
  </main>
  <Footer />
</Base>
