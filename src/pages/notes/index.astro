---
// Engineering notes: newest first.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Backdrop from '../../components/Backdrop.astro';

const entries = (await getCollection('notes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Engineering notes — Muhammed Kado" description="Short write-ups of things learned building and running the six live demos: RTL layouts, deploying on a free VM, billing automation that has to be correct.">
  <Backdrop />
  <Header />
  <main id="main" class="case">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Notes</span>
      </nav>
      <header class="case-head">
        <p class="eyebrow">Engineering notes · <a href="/rss.xml">RSS</a></p>
        <h1>Things learned the hard way</h1>
        <p class="lead">Short, specific write-ups from building and running the demos on this site — the bugs, the fixes, and the rules I kept.</p>
      </header>
      <ul class="notes-list">
        {entries.map((e) => (
          <li>
            <a href={`/notes/${e.id}/`}>
              <span class="k"><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time></span>
              <h2>{e.data.title}</h2>
              <p>{e.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Base>
