---
// English case studies: src/content/work/<slug>.md (ids without a slash).
import { getCollection } from 'astro:content';
import CaseStudy from '../../components/work/CaseStudy.astro';

export async function getStaticPaths() {
  const all = await getCollection('work');
  const entries = all.filter((e) => !e.id.includes('/')).sort((a, b) => a.data.order - b.data.order);
  const twins = new Set(all.filter((e) => e.id.startsWith('tr/')).map((e) => e.id.slice(3)));
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null, hasTwin: twins.has(entry.id) },
  }));
}

const { entry, prev, next, hasTwin } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} lang="en" slug={entry.id} hasTwin={hasTwin} />
